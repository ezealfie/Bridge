@{
    BD bd = new BD();
    bool usuarioLogueado = ViewContext.HttpContext.Session.GetInt32("IdUsuario").HasValue;
    Usuario usuario = bd.ObtenerUsuarioPorId(ViewContext.HttpContext.Session.GetInt32("IdUsuario") ?? 0);
}   

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bridge</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bridge.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;600;700;800&family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
</head>
<body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            @if (!usuarioLogueado)
            {
                <div class="nav-group nav-group--left">
                    <a class="brand-logo-link" href="@Url.Action("Index", "Home")">
                        <img class="brand-logo-image" src="~/Imagenes/LogoBlanco.png" alt="Logo de Bridge" width="74" height="40" />
                    </a>
                    <a href="@Url.Action("Index", "Home")">Inicio</a>
                    <a href="@Url.Action("SobreNosotros", "Home")">Sobre nosotros</a>
                </div>
                <div class="nav-group nav-group--right">
                    <a href="@Url.Action("Login", "Sesiones")">Iniciar Sesion</a>
                    <a class="btn-register" href="@Url.Action("Registrarse", "Sesiones")">Registrarse</a>
                </div>
            }
            else
            {
                <div class="nav-group nav-group--left">
                    <a class="brand-logo-link" href="@Url.Action("Dashboard", "Home")">
                        <img class="brand-logo-image" src="~/Imagenes/LogoBlanco.png" alt="Logo de Bridge" width="74" height="40" />
                    </a>
                    <a href="@Url.Action("Dashboard", "Home")">Inicio</a>
                    <a href="@Url.Action("Grupo", "Home")">Grupos</a>
                    <a href="@Url.Action("Herramientas", "Home")">Herramientas</a>
                    <a href="@Url.Action("AdultoMayor", "Home")">Adulto mayor</a>
                    <a href="@Url.Action("Cuidadores", "Home")">Familia y Cuidadores</a>
                </div>
                <div class="nav-group nav-group--right">
                    <a class="profile-link" href="@Url.Action("Configuracion", "Home")" aria-label="Configuración de perfil">
                        <img class="profile-avatar" src="@(string.IsNullOrEmpty(usuario.fotoPerfil) ? "/Imagenes/avatar.png" : usuario.fotoPerfil)" alt="Foto de perfil" width="30" height="30" onerror="this.onerror=null; this.src='/Imagenes/avatar.png';" />
                    </a>
                </div>
            }
        </nav>
    </header>
    <div class="container" id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top text-muted">
        <div class="footer-brand">
            <p class="FooterH3">Bridge</p>
            <p class="FooterH4">Conservando la vida, facilitando la conexión y el bienestar de nuestros mayores.</p>
        </div>
        <a class="footer-soporte" href="mailto:soporte@bridge.com">Soporte</a>
        <ul>
            <li><a href="@Url.Action("SobreNosotros", "Home")">Sobre nosotros</a></li>
            @if (usuarioLogueado)
            {
                <li><a href="@Url.Action("Herramientas", "Home")">Herramientas</a></li>
                <li><a href="@Url.Action("AdultoMayor", "Home")">Adulto mayor</a></li>
                <li><a href="@Url.Action("Cuidadores", "Home")">Familia y Cuidadores</a></li>
            }
            else
            {
                <li><a href="@Url.Action("Login", "Sesiones")">Herramientas</a></li>
                <li><a href="@Url.Action("Login", "Sesiones")">Adulto mayor</a></li>
                <li><a href="@Url.Action("Login", "Sesiones")">Familia y Cuidadores</a></li>
            }
        </ul>
        <hr><!-- Esto deberia ser la linea -->
        <p><i>Copyright © 2026 Bridge. Todos los derechos reservados.</i></p>
        <a href="@Url.Action("Privacy", "Home")">Privacidad</a>
        <span class="footer-inactivo">Términos de servicio</span>
        <section class="RedesSociales" aria-label="Redes sociales">
            <span class="footer-inactivo"><img src="~/Imagenes/X.png" alt="X" width="16" height="16"></span>
            <span class="footer-inactivo"><img src="~/Imagenes/Instagram.png" alt="Instagram" width="16" height="16"></span>
            <span class="footer-inactivo"><img src="~/Imagenes/YouTube.png" alt="YouTube" width="16" height="16"></span>
            <span class="footer-inactivo"><img src="~/Imagenes/Linkedin.png" alt="LinkedIn" width="16" height="16"></span>
        </section>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
</body>
</html>
