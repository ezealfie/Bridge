@{
    BD bd = new BD();
    bool usuarioLogueado = ViewContext.HttpContext.Session.GetInt32("IdUsuario").HasValue;
    Usuario usuario = bd.ObtenerUsuarioPorId(ViewContext.HttpContext.Session.GetInt32("IdUsuario") ?? 0);
}   

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bridge</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bridge.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;600;700;800&family=Montserrat:ital,wght@0,300;0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
</head>
<body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <header class="bridge-site-header">
        @if (!usuarioLogueado)
        {
            <nav class="bridge-navbar-guest" aria-label="Navegación principal">
                <a class="bridge-brand-guest" href="@Url.Action("Index", "Home")" aria-label="Ir al inicio">
                    <img style="max-width: 80%"  class="bridge-brand-guest__logo" src="~/Imagenes/LogoBlanco.png" alt="Logo de Bridge" />
                </a>

                <div class="bridge-navigation-guest">
                    <a class="bridge-nav-button-guest" href="@Url.Action("Index", "Home")">Inicio</a>
                    <a class="bridge-nav-button-guest" href="@Url.Action("SobreNosotros", "Home")">Sobre nosotros</a>
                </div>

                <div class="bridge-auth-actions">
                    <a class="bridge-login-button" href="@Url.Action("Login", "Sesiones")">Iniciar Sesión</a>
                    <a class="bridge-register-button" href="@Url.Action("Registrarse", "Sesiones")">Registrarse</a>
                </div>
            </nav>
        }
        else
        {
            <nav class="bridge-navbar" aria-label="Navegación principal">
                <a class="bridge-brand" href="@Url.Action("Dashboard", "Home")" aria-label="Ir al inicio">
                    <img class="bridge-brand__logo" style="max-width: 80%" src="~/Imagenes/LogoBlanco.png" alt="Logo de Bridge" />
                </a>

                <div class="bridge-navigation">
                    <a class="bridge-nav-button" href="@Url.Action("Dashboard", "Home")">Inicio</a>
                    <a class="bridge-nav-button" href="@Url.Action("Grupo", "Home")">Grupos</a>
                    <a class="bridge-nav-button" href="@Url.Action("Herramientas", "Home")">Herramientas</a>
                    <a class="bridge-nav-button" href="@Url.Action("AdultoMayor", "Home")">Adulto mayor</a>
                    <a class="bridge-nav-button" href="@Url.Action("Cuidadores", "Home")">Cuidadores</a>
                </div>

                <a class="bridge-profile" href="@Url.Action("Configuracion", "Home")" aria-label="Configuración de perfil">
                    <img class="bridge-profile__avatar" src="@(string.IsNullOrEmpty(usuario.fotoPerfil) ? "/Imagenes/avatar.png" : usuario.fotoPerfil)" alt="Foto de perfil" onerror="this.onerror=null; this.src='/Imagenes/avatar.png';" />
                </a>
            </nav>
        }
    </header>
            @RenderBody()
    <footer class="bridge-footer" role="contentinfo">
        <div class="bridge-footer__main">
            <div class="bridge-footer__brand">
                <p class="bridge-footer__title">Bridge</p>
                <p class="bridge-footer__description">Conservando la vida, facilitando la conexión y el bienestar de nuestros mayores.</p>
            </div>

            <nav class="bridge-footer__navigation" aria-label="Navegación del footer">
                <a href="@Url.Action("SobreNosotros", "Home")">Sobre nosotros</a>
                @if (usuarioLogueado)
                {
                    <a href="@Url.Action("AdultoMayor", "Home")">Adulto mayor</a>
                    <a href="@Url.Action("Cuidadores", "Home")">Cuidadores</a>
                    <a href="@Url.Action("Herramientas", "Home")">Herramientas</a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Sesiones")">Adulto mayor</a>
                    <a href="@Url.Action("Login", "Sesiones")">Cuidadores</a>
                    <a href="@Url.Action("Login", "Sesiones")">Herramientas</a>
                }
            </nav>

            <a class="bridge-footer__support" href="mailto:soporte@bridge.com" aria-label="Contactar soporte">
                <svg class="bridge-footer__mail" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="1.5" y="3" width="13" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2" />
                    <path d="M2.25 4L8 8.5L13.75 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>Soporte</span>
            </a>
        </div>

        <div class="bridge-footer__divider" aria-hidden="true"></div>

        <div class="bridge-footer__meta">
            <p>Copyright © 2026 Bridge. Todos los derechos reservados.</p>

            <nav class="bridge-footer__legal" aria-label="Enlaces legales">
                <a href="@Url.Action("Privacy", "Home")">Privacidad</a>
                <a href="#" aria-label="Términos de servicio">Términos de servicio</a>
            </nav>
        </div>

        <div class="bridge-footer__social" aria-label="Redes sociales">
            <a href="#" aria-label="X"><img src="~/Imagenes/X.png" alt="X" width="24" height="24" /></a>
            <a href="#" aria-label="Instagram"><img src="~/Imagenes/Instagram.png" alt="Instagram" width="24" height="24" /></a>
            <a href="#" aria-label="YouTube"><img src="~/Imagenes/YouTube.png" alt="YouTube" width="24" height="24" /></a>
            <a href="#" aria-label="LinkedIn"><img src="~/Imagenes/Linkedin.png" alt="LinkedIn" width="24" height="24" /></a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
</body>
</html>
