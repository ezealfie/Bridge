<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bridge</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bridge.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <ul>
                @if(ViewContext.HttpContext.Session.GetString("NombreUsuario") == "" && ViewContext.HttpContext.Session.GetString("Contraseña") == ""){                    
                    <li><a href="@Url.Action("Index", "Home")">Inicio</a></li>
                }
                @if(ViewContext.HttpContext.Session.GetString("NombreUsuario") != "" && ViewContext.HttpContext.Session.GetString("Contraseña") != ""){                    
                    <li><a href="@Url.Action("Dashboard", "Home")">Inicio</a></li>
                }
                @if(ViewContext.HttpContext.Session.GetString("NombreUsuario") != "" && ViewContext.HttpContext.Session.GetString("Contraseña") != ""){                    
                    <li><a href="@Url.Action("SobreNosotros", "Home")">Sobre nosotros</a></li>
                    <li><a href="@Url.Action("Grupo", "Home")">Grupos</a></li>
                    <li><a href="@Url.Action("Index", "Home")">Herramientas</a></li> /* Esto deberia ser un dropdown con las herramientas, pero no esta hecha la view todavia */
                    <li><a href="@Url.Action("Index", "Home")">Adulto mayor</a></li>
                    <li><a href="@Url.Action("Index", "Home")">Familia y Cuidadores</a></li>
                    <li><a href="@Url.Action("Index", "Home")"><img src="" alt="Aca va la foto de perfil"></a></li>
                }
                @if(ViewContext.HttpContext.Session.GetString("NombreUsuario") == "" && ViewContext.HttpContext.Session.GetString("Contraseña") == ""){                    
                    <li><a href="@Url.Action("Login", "Sesiones")">Iniciar Sesion</a></li>
                    <li><a href="@Url.Action("Registrarse", "Sesiones")">Registrarse</a></li>
                }
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <h3 class="FooterH3">Bridge</h3>
        <h4 class="FooterH4">Conservando la vida, facilitando la conexión y el bienestar de nuestros mayores.</h4>
        <button type="button" onclick="">Soporte</button> <!-- Aca va el icono de mail antes del texto de soporte, no se como hacerla -->
        <ul>
            <li><a href="@Url.Action("SobreNosotros", "Home")">Sobre nosotros</a></li>
            @if(ViewContext.HttpContext.Session.GetString("NombreUsuario") != "" && ViewContext.HttpContext.Session.GetString("Contraseña") != ""){
                <li><a href="@Url.Action("Herramientas", "Home")">Herramientas</a></li>
                <li><a href="@Url.Action("AdultoMayor", "Home")">Adulto mayor</a></li>
                <li><a href="@Url.Action("Cuidadores", "Home")">Familia y Cuidadores</a></li>
            }
            @if(ViewContext.HttpContext.Session.GetString("NombreUsuario") == "" && ViewContext.HttpContext.Session.GetString("Contraseña") == ""){
                <li><a href="@Url.Action("Login", "Sesiones")">Herramientas</a></li>
                <li><a href="@Url.Action("Login", "Sesiones")">Adulto mayor</a></li>
                <li><a href="@Url.Action("Login", "Sesiones")">Familia y Cuidadores</a></li>
            }
        </ul>
        <hr><!-- Esto deberia ser la linea -->
        <p><i>Copyright © 2026 Bridge. Todos los derechos reservados.</i></p>
        <a href="@Url.Action("Privacy", "Home")">Privacidad</a>
        <a href="">Términos de servicio</a>
        <section class="RedesSociales">
            <a href=""><img src="~/Imagenes/X.png" alt="Logo de X"></a> <!-- Esto deberia ser el logo de X -->
            <a href=""><img src="~/Imagenes/Instagram.png" alt="Logo de Instagram"></a> <!-- Esto deberia ser el logo de Instagram -->
            <a href=""><img src="~/Imagenes/YouTube.png" alt="Logo de YouTube"></a> <!-- Esto deberia ser el logo de YouTube -->
            <a href=""><img src="~/Imagenes/LinkedIn.png" alt="Logo de LinkedIn"></a> <!-- Esto deberia ser el logo de LinkedIn -->
        </section>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
</body>
</html>
