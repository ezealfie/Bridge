@{
    ViewData["Title"] = "Herramientas";
}
<main class="Herramientas-Flex">
    <section class="Contactos">
        <h2>Acceso rapido</h2>
        <div>
            <h3>Contactos</h3>
            @foreach (Usuario cuidador in ViewBag.Proximos3Cuidadores)
            {
                <a class="primary-btn" href="@Url.Action()">@cuidador.nombre: @cuidador.telefono</a>
            }
            <a class="btn-register" href="@Url.Action()">Agregar</a>
        </div>
    </section>
    <section class="Ejercicios">
        <h3>Ejercicios</h3>
        @foreach (Ejercicio ejercicio in ViewBag.Proximos3Ejercicios)
        {
            <div>
                <h4>@ejercicio.nombre</h4>
                <p>@ejercicio.descripcion</p>
                <a class="primary-btn" href="@Url.Action()">Hacer</a>
            </div>
        }
    </section>
    <section class="Articulos">
        <h3>Educación</h3>
        @foreach (Articulo articulo in ViewBag.Proximos3Articulos)
        {
            <div>
                <h4>@articulo.nombre</h4>
                <p>@articulo.descripcion</p>
                <a class="primary-btn" href="@Url.Action()">Leer</a>
            </div>
        }
    </section>
</main>