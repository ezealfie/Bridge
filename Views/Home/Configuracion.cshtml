@{
    string fotoPerfil = ViewBag.user as string;
}

<div class="config-page">

    <!-- Encabezado + cerrar sesión -->
    <div class="config-header">
        <div>
            <p class="config-kicker">Cuenta y privacidad</p>
            <h1>Configuración</h1>
        </div>
        <a class="btn-logout" href="@Url.Action("Logout", "Sesiones")">Cerrar sesión</a>
    </div>

    <div class="config-grid">

        <!-- Foto de perfil -->
        <section class="config-card profile-card">
            <div class="avatar-upload-wrap">
                <div class="avatar-preview" id="avatarPreview">
                    @if (!string.IsNullOrEmpty(fotoPerfil))
                    {
                        <img src="@fotoPerfil" alt="Foto de perfil" />
                    }
                    else
                    {
                        <span>US</span>
                    }
                </div>

                <form method="post" enctype="multipart/form-data" action="@Url.Action("CambiarFotoPerfil", "Home")">
                <input type="file" id="fotoPerfilInput" name="fotoPerfilInput" accept="image/*" onchange="this.form.submit()">
                <label for="fotoPerfilInput" class="upload-btn">Cambiar foto</label>
            </form>
            </div>
        </section>
    </div>

    <!-- Políticas de privacidad -->
    <section class="config-card policy-card">
        <div class="section-title-row">
            <h3>Políticas de privacidad</h3>
        </div>

        <div class="policy-list">
            <div class="policy-item">
                <div>
                    <h4>Perfil público</h4>
                    <p>Permite que otros usuarios vean tu perfil y tu foto.</p>
                </div>
                <button type="button" class="toggle-policy active" data-policy="perfilPublico">Activado</button>
            </div>

            <div class="policy-item">
                <div>
                    <h4>Notificaciones por correo</h4>
                    <p>Recibí avisos y novedades en tu email.</p>
                </div>
                <button type="button" class="toggle-policy" data-policy="notificacionesEmail">Desactivado</button>
            </div>

            <div class="policy-item">
                <div>
                    <h4>Compartir datos de uso</h4>
                    <p>Nos ayuda a mejorar la experiencia de la plataforma.</p>
                </div>
                <button type="button" class="toggle-policy" data-policy="datosUso">Desactivado</button>
            </div>
        </div>
    </section>
</div>

<script>
    document.querySelectorAll('.toggle-policy').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var activo = btn.classList.toggle('active');
            btn.textContent = activo ? 'Activado' : 'Desactivado';
            // Acá podés enviar btn.dataset.policy y 'activo' al servidor con fetch/POST
        });
    });
</script>

