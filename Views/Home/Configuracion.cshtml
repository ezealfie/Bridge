@{
    ViewData["Title"] = "Configuración";
    string fotoPerfil = ViewBag.user as string;
    string nombreUsuario = ViewBag.nombre as string ?? "Usuario";
    string[] partesNombre = nombreUsuario.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    string iniciales = partesNombre.Length > 0 ? char.ToUpper(partesNombre[0][0]).ToString() : "U";
    if (partesNombre.Length > 1) { iniciales += char.ToUpper(partesNombre[1][0]); }
}

<div class="config-page">

    <!-- Encabezado + cerrar sesión -->
    <div class="config-header">
        <div>
            <p class="config-kicker">Cuenta y privacidad</p>
            <h1>Configuración</h1>
        </div>
        <a class="btn-logout" href="@Url.Action("Logout", "Sesiones")">Cerrar sesión</a>
    </div>

    <div class="config-grid">

        <!-- Foto de perfil -->
        <section class="config-card profile-card">
            <div class="avatar-upload-wrap">
                <div class="avatar-preview" id="avatarPreview">
                    <span class="avatar-initials" aria-hidden="true">@iniciales</span>
                    @if (!string.IsNullOrEmpty(fotoPerfil))
                    {
                        <img class="avatar-image" src="@fotoPerfil" alt="Foto de perfil" width="82" height="82" onerror="this.style.display='none'" />
                    }
                </div>

                <form method="post" enctype="multipart/form-data" action="@Url.Action("CambiarFotoPerfil", "Home")">
                <input type="file" id="fotoPerfilInput" name="fotoPerfilInput" accept="image/*" onchange="this.form.submit()">
                <label for="fotoPerfilInput" class="upload-btn">Cambiar foto</label>
            </form>
            </div>
        </section>
    </div>

    <!-- Políticas de privacidad -->
    <section class="config-card policy-card">
        <div class="section-title-row">
            <h2>Políticas de privacidad</h2>
        </div>

        <div class="policy-list">
            <div class="policy-item">
                <div>
                    <h3>Perfil público</h3>
                    <p>Permite que otros usuarios vean tu perfil y tu foto.</p>
                </div>
                <button type="button" class="toggle-policy active" data-policy="perfilPublico" aria-pressed="true">Activado</button>
            </div>

            <div class="policy-item">
                <div>
                    <h3>Notificaciones por correo</h3>
                    <p>Recibí avisos y novedades en tu email.</p>
                </div>
                <button type="button" class="toggle-policy" data-policy="notificacionesEmail" aria-pressed="false">Desactivado</button>
            </div>

            <div class="policy-item">
                <div>
                    <h3>Compartir datos de uso</h3>
                    <p>Nos ayuda a mejorar la experiencia de la plataforma.</p>
                </div>
                <button type="button" class="toggle-policy" data-policy="datosUso" aria-pressed="false">Desactivado</button>
            </div>
        </div>
    </section>
</div>

<script>
    document.querySelectorAll('.toggle-policy').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var activo = btn.classList.toggle('active');
            btn.textContent = activo ? 'Activado' : 'Desactivado';
            // Acá podés enviar btn.dataset.policy y 'activo' al servidor con fetch/POST
        });
    });
</script>

