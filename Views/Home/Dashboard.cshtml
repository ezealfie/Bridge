@{
    ViewData["Title"] = "Panel de control";
    var eventos = ViewBag.Proximos5Eventos as List<Bridge.Models.Evento> ?? new List<Bridge.Models.Evento>();
}
<div class="dashboard-page">
    <section class="landing-brand">
        <h1 class="Logo">BRIDGE</h1>
        <h3 class="subtitle">Conservando la vida</h3>
    </section>
    <section class="dashboard-header">
        <div>
            <p class="dashboard-eyebrow">Panel de control</p>
            <h2>Grupo de cuidado de @ViewBag.NombreAdulto</h2>
        </div>
    </section>
    <div class="dashboard-grid">
        <section class="dashboard-section dashboard-events">
            <div class="dashboard-card">
                <h2>Últimos Eventos</h2>
                @if (eventos.Count == 0)
                {
                    <p class="dashboard-empty">No hay eventos próximos para mostrar.</p>
                }
                else
                {
                    <div class="event-list">
                        @foreach (Evento evento in ViewBag.Proximos5Eventos)
                        {
                            <article class="event-item">
                                <div class="event-date">
                                    <span>@evento.fechaHora.ToString("dd")</span>
                                    <small>@evento.fechaHora.ToString("MMM")</small>
                                </div>
                                <div class="event-content">
                                    <h3>@evento.nombre</h3>
                                    <p class="event-time">@evento.fechaHora.ToString("g")</p>
                                    <p>@evento.descripcion</p>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="dashboard-section dashboard-actions">
            <div class="dashboard-card dashboard-actions-card">
                <h2>Acciones rápidas</h2>
                <div class="button-group">
                    <button type="button" onclick="location.href='@Url.Action("Herramientas", "Home")'">Herramientas</button>
                    <button type="button" onclick="location.href='@Url.Action("AdultoMayor", "Home")'">Adulto mayor</button>
                    <button type="button" onclick="location.href='@Url.Action("Cuidadores", "Home")'">Cuidadores</button>
                </div>
            </div>
        </section>

        <section class="dashboard-section dashboard-group">
            <div class="dashboard-card dashboard-group-card">
                <h2>Cambiar Grupo</h2>
                <button type="button" onclick="location.href='@Url.Action("Grupo", "Home", new { idUsuario = Context.Session.GetInt32("IdUsuario") ?? 0 })'">Cambiar Grupo</button>
            </div>
        </section>
    </div>
</div>
