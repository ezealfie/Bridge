@{
    ViewData["Title"] = "Adulto mayor";
    List<Recordatorio> recordatorios = ViewBag.Recordatorios;
    AdultoMayor adultoMayor = ViewBag.AdultoMayor;
    List<Medicacion> medicaciones = ViewBag.Medicaciones;
    List<Episodio> episodios = ViewBag.Episodios;
    List<Documento> documentos = ViewBag.Documentos;
    BD bd = new BD();
    string nombreAdultoMayor = bd.ObtenerNombreAdulto(Context.Session.GetInt32("IdUsuario") ?? 0);
}

<div class="adulto-page">
    <h1 class="adulto-title">Adulto mayor</h1>

    <div class="adulto-grid">
        <section class="adulto-card">
            <h2>Recordatorios</h2>
            <div class="reminder-list">
                @foreach (Recordatorio recordatorio in recordatorios)
                {
                    <div class="reminder-item">
                        <div class="reminder-meta">
                        <strong>@recordatorio.nombre</strong>
                            <p>@recordatorio.fechaHora.ToString("dd/MM/yyyy HH:mm")</p>
                            <p>@recordatorio.descripcion</p>
                        </div>
                        <a class="primary-btn" href="@Url.Action("Recordatorios", "Home")">
                            Entrar
                        </a>
                    </div>
                }
            </div>

            <div class="card-action">
                <a class="primary-btn" href="@Url.Action("Recordatorios", "Home")">Agregar / Ver más</a>
            </div>
        </section>

        <section class="adulto-card">
            <h2>Datos personales</h2>

            <div class="field-list">
                <div class="field-row">
                    <label for="nombreAdulto">Nombre</label>
                    <input id="nombreAdulto" type="text" value="@nombreAdultoMayor" readonly />
                </div>
                <div class="field-row">
                    <label for="dniAdulto">DNI</label>
                    <input id="dniAdulto" type="text" value="@adultoMayor.dni" readonly />
                </div>
                <div class="field-row">
                    <label for="fechaNacimientoAdulto">Fecha de nacimiento</label>
                    <input id="fechaNacimientoAdulto" type="text" value="@adultoMayor.fecha_nacimiento.ToString("dd/MM/yyyy")" readonly />
                </div>
                <div class="field-row">
                    <label for="condicionAdulto">Condición</label>
                    <input id="condicionAdulto" type="text" value="@adultoMayor.condicion" readonly />
                </div>
            </div>

            <div class="card-action">
                <a class="primary-btn" href="@Url.Action("EditarAdultoMayor", "Home")">Editar</a>
            </div>
        </section>

        <section class="adulto-card">
            <h2>Información médica</h2>

            <div class="medical-list">
                <div class="medical-row">
                    <span class="medical-label">Medicaciones</span>
                    <div class="medical-content">
                        @if (medicaciones != null && medicaciones.Count > 0)
                        {
                            <ul>
                                @foreach (var medicamento in medicaciones)
                                {
                                    <li>
                                    <p><strong>@medicamento.Nombre</strong></p>
                                    <p>@medicamento.descripcion</p>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No hay medicaciones registradas.</p>
                        }
                    </div>
                </div>

                <div class="medical-row">
                    <span class="medical-label">Episodios</span>
                    <div class="medical-content">
                        @if (episodios != null && episodios.Count > 0)
                        {
                            <ul class="episode-list">
                                @foreach (var episodio in episodios)
                                {
                                    <li>
                                        <strong>@episodio.titulo</strong>
                                        <strong>@episodio.fecha_hora.ToString("dd/MM/yyyy HH:mm")</strong>
                                        <p>@episodio.descripcion</p>
                                        <p>Causa: @episodio.causa</p>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No hay episodios registrados.</p>
                        }
                    </div>
                </div>

                <div class="medical-row">
                    <span class="medical-label">Documentos</span>
                    <div class="medical-content">
                        @if (documentos != null && documentos.Count > 0)
                        {
                            <ul>
                                @foreach (var documento in documentos)
                                {
                                    <li>
                                    <p><strong>@documento.titulo</strong></p>
                                    <p>@documento.fecha_hora.ToString("dd/MM/yyyy HH:mm")</p>
                                    <p>@documento.descripcion</p>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No hay documentos cargados.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="card-action">
                <a class="primary-btn" href="@Url.Action("AgregarInfoMedica", "Home")">Agregar / Ver más</a>
            </div>
        </section>
    </div>
</div>


