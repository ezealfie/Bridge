@{
    ViewData["Title"] = "Inicio";
}

<main class="home-page">
    <header class="landing-brand">
        <h1 class="Logo">BRIDGE</h1>
        <p class="subtitle">Conservando la vida</p>
    </header>
    <section class="hero-panel">
        <div class="hero-copy">
            <p>
                En Bridge deseamos poder lograr una mayor calidad de vida para los adultos mayores a través de situaciones difíciles en relación al deterioro cognitivo.
            </p>
            <p>
                Creemos que la empatía, la conexión y el amor al prójimo son las claves para lograr un cambio significativo para las vidas de personas que tan gravemente lo necesitan.
            </p>
            <a class="primary-btn" href="@Url.Action("SobreNosotros", "Home")">Leer más</a>
        </div>

        <div class="hero-image">
            <img src="" alt="Adulto mayor con cuidador" />
        </div>
    </section>
    <section class="services-section">
        <h2>¿Qué podés hacer?</h2>
        <div class="service-list">
            <article class="service-item">
                <div class="service-image" aria-hidden="true"></div>
                <div class="service-body">
                    <h3>Organización de la salud</h3>
                    <p>
                        Centralizá y gestioná toda la información médica del adulto mayor en un solo lugar: medicación, episodios, documentos y recordatorios.
                    </p>
                    <a class="secondary-btn" href="@Url.Action("Login", "Sesiones")">Ver más</a>
                </div>
            </article>
            <article class="service-item">
                <div class="service-image" aria-hidden="true"></div>
                <div class="service-body">
                    <h3>Familia y cuidadores</h3>
                    <p>
                        Determiná los responsables del adulto mayor y mejorá la comunicación entre ellos para lograr mayor bienestar para su ser querido.
                    </p>
                    <a class="secondary-btn" href="@Url.Action("Login", "Sesiones")">Ver más</a>
                </div>
            </article>
            <article class="service-item">
                <div class="service-image" aria-hidden="true"></div>
                <div class="service-body">
                    <h3>Herramientas y bienestar</h3>
                    <p>
                        Accedé rápidamente a contactos importantes, recursos de estimulación mental, ejercicios y otras herramientas que acompañan el bienestar del adulto mayor.
                    </p>
                    <a class="secondary-btn" href="@Url.Action("Login", "Sesiones")">Ver más</a>
                </div>
            </article>
        </div>
    </section>
    <section class="calendar-callout">
        <div class="calendar-placeholder" aria-hidden="true"></div>
        <div class="calendar-copy">
            <h3>Organizá tu calendario con el resto de los cuidadores</h3>
            <a class="primary-btn" href="@Url.Action("Login", "Sesiones")">Ir</a>
        </div>
    </section>
</main>
