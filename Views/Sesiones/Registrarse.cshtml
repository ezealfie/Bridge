<h1>Registrarse</h1>
<form class="register-form" action="@Url.Action("RegistrarseVerificar", "Sesiones")" method="POST">
    <label>Correo electrónico:</label><br>
    <input type="text" name="email" placeholder="Ingrese su correo electrónico" required /><br>
    <label>Nombre:</label><br>
    <input type="text" name="nombre" placeholder="Ingrese su nombre" required /><br>
    <label>Apellido:</label><br>
    <input type="text" name="apellido" placeholder="Ingrese su apellido" required /><br>
    <label>Tipo de Usuario:</label><br>
    <select name="tipoUsuario" required>
        <option value="Cuidador">Cuidador</option>
        <option value="Adulto Mayor">Adulto Mayor</option>
    </select><br>
    <label>Contraseña:</label><br>
    <input type="password" name="contrasena" placeholder="Ingrese su contraseña" required /><br>
    <label>Repetir Contraseña:</label><br>
    <input type="password" name="repetirContrasena" placeholder="Repita su contraseña" required /><br>
    <button type="submit">Registrarse</button>
</form>
<p class="text-danger">@ViewBag.Message</p>
<p>¿Ya tenés una cuenta? <a href="@Url.Action("Login", "Sesiones")">Iniciar Sesión</a></p>
